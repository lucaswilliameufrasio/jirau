#!/usr/bin/env sh
# Wrapper executável para o JetBrains Amper
DIR="$(cd "$(dirname "$0")" && pwd)"
if command -v amper >/dev/null 2>&1; then
    exec amper "$@"
elif [ -f "$DIR/gradlew" ]; then
    exec "$DIR/gradlew" "$@"
else
    echo "Erro: Amper CLI ou Gradle Wrapper não encontrados em $DIR"
    exit 1
fi
